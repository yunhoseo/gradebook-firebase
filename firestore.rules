rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function googleUser(){return request.auth != null && request.auth.token.email_verified == true && request.auth.token.firebase.sign_in_provider == 'google.com';}
  function owner(){return googleUser() && request.auth.token.email.lower() == 'yunho.seo@kyonggi.ac.kr';}
  function staff(){return googleUser() && (owner() || (exists(/databases/$(database)/documents/members/$(request.auth.token.email.lower())) && get(/databases/$(database)/documents/members/$(request.auth.token.email.lower())).data.active == true));}
  match /members/{email} {
   allow get: if owner() || (googleUser() && request.auth.token.email.lower() == email);
   allow list: if owner();
   allow create, update: if owner() && request.resource.data.keys().hasOnly(['active']) && request.resource.data.active == true && email != 'yunho.seo@kyonggi.ac.kr';
   allow delete: if owner() && email != 'yunho.seo@kyonggi.ac.kr';
  }
  match /gradebooks/shared {
   allow read: if staff();
   function valid(){return request.resource.data.keys().hasOnly(['payload','revision','updatedBy','updatedAt']) && request.resource.data.payload is string && request.resource.data.payload.size() <= 750000 && request.resource.data.revision is int && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time;}
   allow create: if staff() && valid() && request.resource.data.revision == 1;
   allow update: if staff() && valid() && request.resource.data.revision == resource.data.revision + 1;
   allow delete: if false;
  }
 }
}
