{
  "name": "gradebook-firebase",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/model.test.mjs tests/sync.test.mjs",
    "test:rules": "firebase emulators:exec --project demo-gradebook --only firestore \"node --test tests/rules.test.mjs\"",
    "preview": "firebase emulators:start --project demo-gradebook --only hosting,auth,firestore",
    "deploy": "npm run build && firebase deploy --only firestore:rules,firestore:indexes,hosting"
  },
  "dependencies": {
    "esbuild": "^0.28.2",
    "firebase": "^13.1.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "firebase-tools": "^15.34.1"
  }
}